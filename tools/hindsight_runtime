#!/usr/bin/env bash
# Provisions the pinned Hindsight runtime the memory service runs (python3 -m tools.memory service).
set +x
set -euo pipefail
umask 077
ulimit -c 0

fail() {
    printf 'hindsight: %s\n' "$*" >&2
    exit 1
}

usage() {
    printf '%s\n' 'Usage: tools/hindsight_runtime guide|install'
}

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
command=${1:-}
case "$command" in
    -h|--help|'') usage; exit 0 ;;
    guide) cat -- "$script_dir/hindsight_runtime.guide.txt"; exit 0 ;;
    install) shift ;;
    *) usage >&2; exit 2 ;;
esac

[[ $# == 0 ]] || fail "$command takes no arguments."
common_dir=$(git -C "$script_dir" rev-parse --path-format=absolute --git-common-dir)
repo_dir=$(cd -- "$(dirname -- "$common_dir")" && pwd -P)
work_dir=$repo_dir/work
[[ ! -L $work_dir ]] || fail 'The canonical work directory must stay inside the repository.'
mkdir -p -- "$work_dir"
default_root=$work_dir/hindsight-runtime
state_root=${ICARUS_HINDSIGHT_STATE_ROOT:-$default_root}
assets_root=${ICARUS_HINDSIGHT_ASSETS_ROOT:-$default_root}

prepare_root() {
    local requested=$1 resolved
    if [[ $requested == "$default_root" && ! -e $requested && ! -L $requested ]]; then
        mkdir -m 700 -- "$requested" 2>/dev/null || [[ -d $requested ]] || return 1
    fi
    resolved=$(realpath -e -- "$requested") || return 1
    [[ $resolved == "$work_dir/"* && -d $resolved && -O $resolved && $(stat -c '%a' -- "$resolved") == 700 ]] ||
        return 1
    printf '%s\n' "$resolved"
}

state_root=$(prepare_root "$state_root") || fail 'State root must be an existing owner-only (0700) directory under the canonical work directory.'
assets_root=$(prepare_root "$assets_root") || fail 'Assets root must be an existing owner-only (0700) directory under the canonical work directory.'
if [[ $state_root == "$default_root" || $assets_root == "$default_root" ]]; then
    (set -o noclobber
     printf '%s\n' '{"state":"open","owner":"operator","purpose":"Project-local Hindsight runtime and scopes"}' > "$default_root/case.json"
    ) 2>/dev/null || [[ -f $default_root/case.json ]] || fail 'Could not initialize the runtime case.'
fi

venv=$assets_root/venv
requirements=$script_dir/hindsight_runtime.requirements.txt
lock_digest=$(sha256sum "$requirements" | cut -d ' ' -f 1)
install_stamp=$assets_root/wheels.sha256
assets_lock=$assets_root/assets.lock
model_cache=$assets_root/.cache/hf
embedding_repo=intfloat/multilingual-e5-small
embedding_revision=614241f622f53c4eeff9890bdc4f31cfecc418b3
reranker_repo=hindsight-ai/hs-rerank-1
reranker_revision=927f5be31280298a51cf29af8a29cb111ed812c5
embedding=$model_cache/hub/models--${embedding_repo/\//--}/snapshots/$embedding_revision
reranker=$model_cache/hub/models--${reranker_repo/\//--}/snapshots/$reranker_revision
# Reserve a margin above the repository's 30 GiB floor.
floor=$((31 * 1024 ** 3))
has_space() {
    local dir bytes
    for dir in "$state_root" "$assets_root"; do
        bytes=$(df -B1 --output=avail -- "$dir" | tail -1) || return 1
        (( bytes > floor )) || return 1
    done
}

wheels_verified() {
    [[ -f $install_stamp && $(<"$install_stamp") == "$lock_digest" ]]
}

models_present() {
    local file
    for file in "$embedding"/{config.json,tokenizer.json,tokenizer_config.json,special_tokens_map.json,sentencepiece.bpe.model,onnx/model.onnx} \
        "$reranker"/{config.json,tokenizer.json,tokenizer_config.json,onnx/model.onnx}; do
        [[ -s $file ]] || return 1
    done
}

clean_environment() {
    # Keep only executable lookup. Prevent inherited provider, proxy, .env and cache settings
    # from changing this instance. Empty HOME below is private runtime state.
    local name
    while IFS= read -r name; do
        # shellcheck disable=SC2163
        case "$name" in PATH) ;; *) export -n "$name" 2>/dev/null || true ;; esac
    done < <(compgen -e)
    export LANG=C.UTF-8 PYTHONDONTWRITEBYTECODE=1 PYTHONNOUSERSITE=1 PYTHON_DOTENV_DISABLED=1
    export HF_HOME="$model_cache" HF_HUB_DISABLE_TELEMETRY=1 HF_HUB_DISABLE_IMPLICIT_TOKEN=1
    export OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=1 TOKENIZERS_PARALLELISM=false
}

# Invoked in a fresh bash under timeout.
# shellcheck disable=SC2329
install_runtime() {
    export HOME="$assets_root/home" TMPDIR="$assets_root/tmp"
    export XDG_CONFIG_HOME="$HOME/config" XDG_DATA_HOME="$HOME/data" XDG_STATE_HOME="$HOME/state"
    export XDG_CACHE_HOME="$assets_root/.cache" UV_CACHE_DIR="$assets_root/.cache/uv"
    export UV_HTTP_TIMEOUT=20 UV_HTTP_RETRIES=1 UV_CONCURRENT_DOWNLOADS=2 UV_CONCURRENT_INSTALLS=2
    mkdir -p -- "$HOME" "$TMPDIR" "$UV_CACHE_DIR" "$model_cache"
    cd -- "$assets_root"
    [[ $(uname -sm) == 'Linux x86_64' ]] || fail 'The wheel lock supports Linux x86_64.'
    local glibc
    glibc=$(getconf GNU_LIBC_VERSION) || fail 'The wheel lock requires glibc 2.35 or later.'
    [[ $glibc =~ ^glibc\ ([0-9]+)\.([0-9]+)$ ]] || fail 'The wheel lock requires glibc 2.35 or later.'
    (( BASH_REMATCH[1] > 2 || (BASH_REMATCH[1] == 2 && BASH_REMATCH[2] >= 35) )) ||
        fail 'The wheel lock requires glibc 2.35 or later.'
    [[ -x /usr/bin/python3.14 ]] || fail 'Install system Python 3.14 at /usr/bin/python3.14.'
    if [[ ! -x $venv/bin/python ]]; then
        uv --no-config venv --python /usr/bin/python3.14 --no-python-downloads "$venv"
    fi
    local -a refresh=()
    wheels_verified || refresh+=(--reinstall)
    uv --no-config pip sync --python "$venv/bin/python" --default-index https://pypi.org/simple \
        --only-binary :all: --require-hashes --link-mode hardlink "${refresh[@]}" "$requirements"
    uv --no-config pip check --python "$venv/bin/python"
    if ! models_present; then
        "$venv/bin/hf" download "$embedding_repo" --revision "$embedding_revision" --max-workers 2 \
            config.json tokenizer.json tokenizer_config.json special_tokens_map.json sentencepiece.bpe.model onnx/model.onnx
        "$venv/bin/hf" download "$reranker_repo" --revision "$reranker_revision" --max-workers 2 \
            config.json tokenizer.json tokenizer_config.json onnx/model.onnx
    fi
    models_present || fail 'Pinned CPU model snapshots are incomplete.'
    local stamp
    stamp=$(mktemp -- "$install_stamp.XXXXXXXX")
    printf '%s\n' "$lock_digest" > "$stamp"
    mv -fT -- "$stamp" "$install_stamp"
}

if [[ $command == install ]]; then
    has_space || fail 'Installation needs more than 31 GiB free.'
    exec 9>"$assets_lock"
    flock -n -x 9 || fail 'Stop the running project instance before installing.'
    # The installer inherits no provider keys, shell startup files or user package configuration.
    clean_environment
    export assets_root model_cache embedding reranker embedding_repo embedding_revision reranker_repo reranker_revision
    export venv requirements lock_digest install_stamp
    export -f install_runtime models_present wheels_verified fail
    timeout --kill-after=5s 900s bash -euo pipefail -c install_runtime 9>&- &
    install_pid=$!
    trap 'kill -TERM "$install_pid" 2>/dev/null || true; wait "$install_pid" 2>/dev/null || true' EXIT
    trap 'exit 130' INT TERM HUP
    while kill -0 "$install_pid" 2>/dev/null; do
        has_space || fail 'Installation stopped at the 31 GiB disk tripwire.'
        sleep 2
    done
    wait "$install_pid"
    trap - EXIT INT TERM HUP
    printf 'Hindsight packages and CPU models ready in %s\n' "$assets_root"
    exit 0
fi
